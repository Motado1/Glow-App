{
  "expo": {
    "name": "Glow Field Ops",
    "slug": "glow-field-ops",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glowfieldops",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3D2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Glow to take farm photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Glow to import drone and gallery photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Glow to tag photos and plan efficient routes."
        }
      ]
    ],
    "extra": {
      "backend": "local"
    }
  }
}
